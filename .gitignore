# 论文 PDF 与 LaTeX 编译产物（仅本地保留）
*.pdf
*.aux
*.bbl
*.blg
*.log
*.out
*.synctex.gz
*.fls
*.fdb_latexmk
*.toc
*.lof
*.lot
*.nav
*.snm
*.vrb
*.bcf
*.run.xml

# 模板库内的说明/示例 PDF 允许入库
!templates/**/*.pdf

# Python
__pycache__/
*.py[cod]
.Python
.venv/
.venv-*/
venv/
.pytest_cache/

# OS / editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# 临时文件
*.tmp
*.log
condaenv.*.requirements.txt

# ---------------------------------------------------------------------------
# 学习项目（P1–P5）运行时产物 —— 本地可复现，不同步云端
# ---------------------------------------------------------------------------

# 通用：脚本写出的 outputs/（图、CSV、自动报告）
learning/**/outputs/

# P3：SCALE-Sim 运行时写出的 topology/layout
learning/p3_arch_eval/scale-sim/attention_tiles.csv
learning/p3_arch_eval/scale-sim/default_layout.csv

# P3：Timeloop / Accelergy 运行时产物
learning/p3_arch_eval/timeloop/generated/
learning/p3_arch_eval/timeloop/accelergy_outputs/

# P4：Verilator 编译、测试向量与仿真产物
learning/p4_rtl/build/

# ---------------------------------------------------------------------------
# 正式研究实验产物 —— 云端仅同步 REPORT.md；其余仅本地
# ---------------------------------------------------------------------------
# 约定：research/**/experiments/<name>/{run_*.py, REPORT.md, results/, ...}
# research 下非 experiments 的目录（cache_path、protocols 等）正常入库。
# experiments 骨架（.gitkeep、configs/）保留；各实验子目录只入库 REPORT.md。
research/**/experiments/**/*
!research/**/experiments/**/
!research/**/experiments/.gitkeep
!research/**/experiments/configs/
!research/**/experiments/configs/**
!research/**/experiments/**/REPORT.md
research/**/outputs/

# Local tool downloads
.tools/
